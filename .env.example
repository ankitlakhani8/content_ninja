# Copy to .env (local) or set these as environment variables on your host.

# --- Keyword enrichment (pick one; both optional) ---------------------------
# DataForSEO: free trial credits at https://app.dataforseo.com/register
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Keywords Everywhere: https://keywordseverywhere.com/api.html
KEYWORDS_EVERYWHERE_API_KEY=

# --- Alerts (optional; a webhook can also be pasted per run in the UI) ------
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# --- Behaviour ---------------------------------------------------------------
# Posts published within this many days count as "new" on the very first (baseline) run.
NEW_WINDOW_DAYS=7
# Where the SQLite database lives (mount a persistent disk here in production).
DB_PATH=data/monitor.db
